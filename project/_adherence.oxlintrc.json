{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/dashboard/**",
              "components/display/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/marketing-site/**",
              "ui_kits/seo-console-dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|Inter|JetBrains Mono|Geist))/i]",
        "message": "Font not provided by the design system. Available: Manrope, Inter, JetBrains Mono, Geist."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|initials|fill|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, initials, fill, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='fill'] > Literal[value!=/^(?:neutral|orange|pink|violet|emerald)$/]",
        "message": "<Avatar> fill must be one of 'neutral' | 'orange' | 'pink' | 'violet' | 'emerald'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|orange|pink|violet|emerald)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'orange' | 'pink' | 'violet' | 'emerald'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|disabled|iconLeft|iconRight|href|onClick|fullWidth|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, disabled, iconLeft, iconRight, href, onClick, fullWidth, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryTab> doesn't accept that prop. Declared props: children, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBandLight'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|subline|ctaLabel|onCtaClick|style|key|ref|className|style|children)$/]",
        "message": "<CtaBandLight> doesn't accept that prop. Declared props: heading, subline, ctaLabel, onCtaClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CustomerProofCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:avatar|name|role|quote|rating|style|key|ref|className|style|children)$/]",
        "message": "<CustomerProofCard> doesn't accept that prop. Declared props: avatar, name, role, quote, rating, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:field|label|align|color|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: field, label, align, color, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateRangePreset'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<DateRangePreset> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: icon, title, description, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureIconCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|style|key|ref|className|style|children)$/]",
        "message": "<FeatureIconCard> doesn't accept that prop. Declared props: icon, title, description, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterState'] > JSXAttribute > JSXIdentifier[name!=/^(?:contains|position|trend|branded|question|longtail|ai|key|ref|className|style|children)$/]",
        "message": "<FilterState> doesn't accept that prop. Declared props: contains, position, trend, branded, question, longtail, ai."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterState'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:all|growing|decaying|new)$/]",
        "message": "<FilterState> trend must be one of 'all' | 'growing' | 'decaying' | 'new'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterState'] > JSXAttribute[name.name='branded'] > Literal[value!=/^(?:all|branded|nonbranded)$/]",
        "message": "<FilterState> branded must be one of 'all' | 'branded' | 'nonbranded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoogleSignInButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GoogleSignInButton> doesn't accept that prop. Declared props: label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroAppMockupCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<HeroAppMockupCard> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|heading|subline|actions|mockup|style|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: eyebrow, heading, subline, actions, mockup, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|onClick|href|disabled|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, onClick, href, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|delta|deltaGood|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<MetricCard> doesn't accept that prop. Declared props: label, value, color, delta, deltaGood, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavPillGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:segments|active|onChange|style|key|ref|className|style|children)$/]",
        "message": "<NavPillGroup> doesn't accept that prop. Declared props: segments, active, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|period|features|ctaLabel|onCtaClick|featured|style|key|ref|className|style|children)$/]",
        "message": "<PricingTierCard> doesn't accept that prop. Declared props: name, price, period, features, ctaLabel, onCtaClick, featured, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductMockupCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<ProductMockupCard> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingStars'] > JSXAttribute > JSXIdentifier[name!=/^(?:rating|max|size|style|key|ref|className|style|children)$/]",
        "message": "<RatingStars> doesn't accept that prop. Declared props: rating, max, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|value|onChange|placeholder|type|disabled|iconLeft|id|name|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint, error, value, onChange, placeholder, type, disabled, iconLeft, id, name, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|tone|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, tone, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|accent|muted|on-dark)$/]",
        "message": "<TextLink> tone must be one of 'ink' | 'accent' | 'muted' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:body-md|body-sm|caption)$/]",
        "message": "<TextLink> size must be one of 'body-md' | 'body-sm' | 'caption'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:system|light|dark)$/]",
        "message": "<ThemeToggle> value must be one of 'system' | 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<TopNavItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrendPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:pct|invert|size|style|key|ref|className|style|children)$/]",
        "message": "<TrendPill> doesn't accept that prop. Declared props: pct, invert, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|on-dark)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'on-dark'."
      }
    ]
  },
